{
    "name": "file-manager",
    "displayName": "File Manager",
    "description": "Two-panel file manager in an editor tab, in the spirit of Total Commander and Midnight Commander.",
    "version": "1.1.0",
    "publisher": "AlekVolsk",
    "author": "AlekVolsk",
    "license": "BSD-3-Clause",
    "icon": "images/fm.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/AlekVolsk/vscode-file-manager.git"
    },
    "keywords": [
        "file manager",
        "commander",
        "two panel",
        "files"
    ],
    "engines": {
        "vscode": "^1.94.0"
    },
    "categories": [
        "Other"
    ],
    "extensionKind": [
        "workspace"
    ],
    "main": "./src/extension.js",
    "activationEvents": [
        "onWebviewPanel:fileManager"
    ],
    "scripts": {
        "build": "npx --yes @vscode/vsce package -o file-manager.vsix",
        "check": "tsc -p src/jsconfig.json && tsc -p media/jsconfig.json"
    },
    "contributes": {
        "commands": [
            {
                "command": "fileManager.open",
                "title": "%command.open%",
                "category": "%command.category%",
                "icon": {
                    "light": "images/fm.svg",
                    "dark": "images/fm.svg"
                }
            },
            {
                "command": "fileManager.action",
                "title": "%command.action%",
                "category": "%command.category%"
            }
        ],
        "configuration": {
            "title": "%config.title%",
            "properties": {
                "fileManager.language": {
                    "type": "string",
                    "scope": "application",
                    "enum": [
                        "auto",
                        "en",
                        "cs",
                        "de",
                        "es",
                        "fr",
                        "it",
                        "ja",
                        "ko",
                        "pl",
                        "pt-br",
                        "ru",
                        "tr",
                        "zh-cn",
                        "zh-tw"
                    ],
                    "enumItemLabels": [
                        "auto",
                        "English",
                        "Čeština",
                        "Deutsch",
                        "Español",
                        "Français",
                        "Italiano",
                        "日本語",
                        "한국어",
                        "Polski",
                        "Português (Brasil)",
                        "Русский",
                        "Türkçe",
                        "简体中文",
                        "繁體中文"
                    ],
                    "default": "auto",
                    "markdownDescription": "%config.language%"
                },
                "fileManager.customTranslations": {
                    "type": "object",
                    "scope": "application",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "default": {},
                    "markdownDescription": "%config.customTranslations%"
                },
                "fileManager.startFolder": {
                    "type": "string",
                    "enum": [
                        "last",
                        "home",
                        "project",
                        "root"
                    ],
                    "enumDescriptions": [
                        "%config.startFolder.last%",
                        "%config.startFolder.home%",
                        "%config.startFolder.project%",
                        "%config.startFolder.root%"
                    ],
                    "default": "last",
                    "markdownDescription": "%config.startFolder%"
                },
                "fileManager.tableScale": {
                    "type": "integer",
                    "default": 0,
                    "minimum": -10,
                    "maximum": 30,
                    "markdownDescription": "%config.tableScale%"
                },
                "fileManager.hideExtensionOnRename": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "%config.hideExtensionOnRename%"
                },
                "fileManager.unpackIntoSubfolder": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "%config.unpackIntoSubfolder%"
                },
                "fileManager.packFormat": {
                    "type": "string",
                    "enum": [
                        "zip",
                        "tgz",
                        "tar"
                    ],
                    "enumItemLabels": [
                        "zip",
                        "tar.gz",
                        "tar"
                    ],
                    "default": "zip",
                    "markdownDescription": "%config.packFormat%"
                }
            }
        },
        "menus": {
            "editor/title": [
                {
                    "command": "fileManager.open",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "fileManager.action",
                    "when": "false"
                }
            ]
        },
        "keybindings": [
            {
                "key": "f1",
                "command": "fileManager.action",
                "args": "help",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f2",
                "command": "fileManager.action",
                "args": "rename",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f3",
                "command": "fileManager.action",
                "args": "properties",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f4",
                "command": "fileManager.action",
                "args": "edit",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "shift+f4",
                "command": "fileManager.action",
                "args": "newFile",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f5",
                "command": "fileManager.action",
                "args": "copy",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f6",
                "command": "fileManager.action",
                "args": "move",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f7",
                "command": "fileManager.action",
                "args": "newFolder",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f8",
                "command": "fileManager.action",
                "args": "delete",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "shift+f8",
                "command": "fileManager.action",
                "args": "deletePermanently",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f9",
                "command": "fileManager.action",
                "args": "attributes",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "alt+f5",
                "command": "fileManager.action",
                "args": "pack",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "alt+f9",
                "command": "fileManager.action",
                "args": "unpack",
                "when": "activeWebviewPanelId == 'fileManager'"
            },
            {
                "key": "f10",
                "command": "fileManager.action",
                "args": "close",
                "when": "activeWebviewPanelId == 'fileManager'"
            }
        ]
    },
    "dependencies": {
        "tar": "^7.5.22",
        "yauzl": "^3.4.0",
        "yazl": "^3.3.1"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@types/vscode": "1.94.0",
        "@types/yauzl": "^3.4.0",
        "@types/yazl": "^3.3.1",
        "typescript": "^7.0.2"
    }
}
